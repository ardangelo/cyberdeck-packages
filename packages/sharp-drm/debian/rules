#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	test -n "$(K230_KERNEL_DIR)"
	test -n "$(K230_KERNEL_RELEASE)"
	test -n "$(K230_CROSS_COMPILE)"
	$(MAKE) -C "$(K230_KERNEL_DIR)" M="$(CURDIR)" ARCH=riscv CROSS_COMPILE="$(K230_CROSS_COMPILE)" modules

override_dh_auto_install:
	install -D -m 0644 sharp-drm.ko "debian/tmp/lib/modules/$(K230_KERNEL_RELEASE)/updates/sharp-drm.ko"
	install -D -m 0644 debian/config/modules-load.conf "debian/tmp/etc/modules-load.d/k230-sharp-drm.conf"
	install -D -m 0644 debian/config/modprobe.conf "debian/tmp/etc/modprobe.d/k230-sharp-drm.conf"
	printf '%s\n' "$(K230_KERNEL_RELEASE)" > debian/k230-kernel-abi.release
	install -D -m 0644 debian/k230-kernel-abi.release "debian/tmp/usr/share/k230-kernel-abi/$(K230_KERNEL_RELEASE)"

override_dh_auto_clean:
	if test -n "$(K230_KERNEL_DIR)" && test -f "$(K230_KERNEL_DIR)/Makefile"; then \
		$(MAKE) -C "$(K230_KERNEL_DIR)" M="$(CURDIR)" ARCH=riscv CROSS_COMPILE="$(K230_CROSS_COMPILE)" clean; \
	fi
	rm -f debian/k230-kernel-abi.release

override_dh_strip:
	# Preserve the kernel module exactly as produced by Kbuild.
